{
  "name": "kronkoll",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint . && node scripts/no-js-sources.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "architecture": "depcruise packages apps --config .dependency-cruiser.json && node scripts/no-payment-endpoints.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.14.0",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.151.1"
  }
}
