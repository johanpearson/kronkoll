// API-workern (D-origin). Den har ingen publik adress: den nås bara från Pages Function
// via service binding, så alla anrop har passerat Cloudflare Access först.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kronkoll-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  // Åtkomstkontrollen (KK-2-B, KK-29-B). ACCESS_AUD och ACCESS_ALLOWED_EMAILS är secrets och
  // sätts i Cloudflare (Workers & Pages → kronkoll-api → Settings → Variables and Secrets).
  // Saknas något av de fyra värdena nekar workern alla anrop.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://nameless-wildflower-f9e8.cloudflareaccess.com",
    "APP_ORIGIN": "https://kronkoll-25e.pages.dev"
  },
  // Databasens id är inte hemligt. Åtkomst kräver Cloudflare-token.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kronkoll",
      "database_id": "0e4be508-471c-418a-8547-c320e4076268",
      "migrations_dir": "migrations"
    }
  ]
}
