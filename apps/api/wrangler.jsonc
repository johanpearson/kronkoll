// API-workern (D-origin). Den har ingen publik adress: den nås bara från Pages Function
// via service binding, så alla anrop har passerat Cloudflare Access först.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kronkoll-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  // Åtkomstkontrollen (KK-2-B, KK-29-B). ACCESS_AUD och ACCESS_ALLOWED_EMAILS är secrets och
  // sätts i Cloudflare (Workers & Pages → kronkoll-api → Settings → Variables and Secrets).
  // Saknas något av de fyra värdena nekar workern alla anrop.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://nameless-wildflower-f9e8.cloudflareaccess.com",
    "APP_ORIGIN": "https://kronkoll-25e.pages.dev"
  },
  // Schemalagd synk två gånger per dygn (UTC), ungefär 05 och 16 vintertid (KK-7, D-sync).
  // Hemligheterna EB_APP_ID, EB_PRIVATE_KEY, SESSION_ENC_KEY, VAPID_PUBLIC_KEY och VAPID_PRIVATE_KEY
  // sätts med `wrangler secret put` (VAPID-paret skapas med `node scripts/vapid-keys.ts`).
  "triggers": { "crons": ["7 4,15 * * *"] },
  // Databasens id är inte hemligt. Åtkomst kräver Cloudflare-token.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kronkoll",
      "database_id": "0e4be508-471c-418a-8547-c320e4076268",
      // Schemat och migreringarna finns i packages/adapter-d1 (D-orm). Deploy-flödet kör dem
      // med `wrangler d1 migrations apply kronkoll --remote` innan workern deployas.
      "migrations_dir": "../../packages/adapter-d1/migrations"
    }
  ]
}
