// API-workern (D-origin). Den har ingen publik adress: den nås bara från Pages Function
// via service binding, så alla anrop har passerat Cloudflare Access först.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kronkoll-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
