    "@kronkoll/domain": "workspace:*",
    "@kronkoll/logging": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "5.20261016.1",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  }
}
